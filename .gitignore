# Vaqtinchalik/generatsiya qilingan fayllar
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Baza va loglar (har bir muhitda o'zi yaratiladi)
logs/*.db
logs/*.log
*.db
*.sqlite3

# Agent runtime fayllari
agent_hash_cache.json
agent.log

# TLS: ichki CA/server/client sertifikat va KALITLARI - hech qachon
# git'ga commit qilinmaydi (deploy/pki/generate_ca.sh orqali har bir
# muhitda mahalliy generatsiya qilinadi). docs_TLS_SETUP.md'ga qarang.
deploy/pki/certs/

# Muhit sozlamalari (maxfiy ma'lumot - .env.example commit qilinadi, .env emas)
.env
.env.local
# MUHIM (config/secrets audit orqali topilgan real bo'shliq): vaqtinchalik
# qo'lda yaratilgan zaxira nusxalar (masalan `.env.bak_20260907_134206`)
# yuqoridagi aniq `.env` qoidasi bilan QAMRAB OLINMAYDI (fayl nomi
# boshqacha) - bunday fayl `git add -A` orqali TASODIFAN commit qilinib,
# real parollar GitHub'ga chiqib ketishi mumkin edi. `.env.save`/`.env.bak`
# `*.save`/`*.bak` orqali allaqachon qamrab olingan, lekin timestamp
# qo'shilgan variant (`.env.bak_...`) uchun alohida qoida kerak edi.
.env.bak*
# Vim/editor almashtirish (swap) fayllari - .env'ni tahrirlaganda
# yaratiladigan "..env.swp" kabi fayllar HAM maxfiy ma'lumot bo'lishi
# mumkin (.env'ning vaqtinchalik nusxasi), lekin yuqoridagi ".env"
# qoidasi ularni QAMRAB OLMAYDI (fayl nomi boshqacha).
*.swp
*.swo
*.save
*.bak

# Hisobot chiqishlari
report_output/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Backup fayllar
backups/
*.before_restore

# Zip arxivlar
*.zip
