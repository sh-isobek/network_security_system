# Ushbu faylni .env nomiga ko'chirib, o'z qiymatlaringizni kiriting
NETWORK_RANGE_START=172.16.0.11
NETWORK_RANGE_END=172.16.3.254

SYSLOG_HOST=0.0.0.0
SYSLOG_PORT=5140

# Yagona ishga tushirish (SQLite) uchun:
DATABASE_URL=sqlite:///./logs/security_system.db
# Docker Compose (PostgreSQL) uchun avtomatik quriladi - pastga qarang

RAW_LOG_FILE=./logs/raw_syslog.log
LOG_LEVEL=INFO

# --- Vaqt zonasi (Toshkent, UTC+5) ---
# TZ: konteynerlarning o'z tizim vaqtini belgilaydi (masalan `docker
# logs` vaqt belgilari, cron jadvallari to'g'ri ko'rinishi uchun).
# TIMEZONE_OFFSET_HOURS: Dashboard'da FOYDALANUVCHIGA ko'rsatiladigan
# vaqt siljishi (bazaning o'zi har doim UTC'da saqlanadi - bu FAQAT
# ko'rsatish uchun, boshqa hech narsaga ta'sir qilmaydi).
TZ=Asia/Tashkent
TIMEZONE_OFFSET_HOURS=5

# Dashboard'da qurilma "tarmoqqa ulangan (onlayn)" / "uzilgan (offlayn)"
# deb ko'rsatilishi uchun chegara - shu daqiqadan ko'proq vaqt
# Device.last_seen yangilanmasa, qurilma "offlayn" hisoblanadi.
DEVICE_OFFLINE_THRESHOLD_MINUTES=60

# --- Docker Compose uchun PostgreSQL (faqat docker-compose.yml ishlatganda) ---
POSTGRES_DB=security_system
POSTGRES_USER=security_admin
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Threat Intel API kalitlari (ixtiyoriy) ---
VT_API_KEY=

# --- 5-bosqich: Avtomatik javob choralari ---
# UniFi Controller - IKKI usul qo'llab-quvvatlanadi:
#
# USUL 1 (ASOSIY, TAVSIYA ETILADI): API Key - login/parol shart emas.
# API kalitni yaratish: UniFi Network > Control Plane > Integrations.
# Sayt ID **UUID** ko'rinishida bo'lishi kerak (masalan
# "88f7af54-98f8-306a-a1c7-c9349722b1f6"), sayt NOMI ("default") emas -
# buni UniFi'ning o'zidan (Sites ro'yxati) yoki
# GET /proxy/network/integration/v1/sites so'rovidan oling.
UNIFI_CONTROLLER_URL=https://172.16.0.1:8443
UNIFI_API_KEY=
UNIFI_SITE_ID=
UNIFI_VERIFY_SSL=false
#
# USUL 2 (ZAXIRA): login/parol - faqat API Key ishlamasa yoki eski
# dastur versiyasida ishlatiladi. USUL 1 sozlangan bo'lsa, bu qatorlar
# faqat API Key muvaffaqiyatsiz bo'lgan holatda zaxira sifatida ishlaydi.
UNIFI_USERNAME=
UNIFI_PASSWORD=
UNIFI_SITE=default
# "true" = UniFi OS konsoli (UDM/UDR/Cloud Key G2+, standart 443-port)
# "false" = self-hosted klassik dastur (masalan Docker, odatda
# standart bo'lmagan port - agar sizning portingiz 443 bo'lmasa,
# ehtimol bu "false" bo'lishi kerak)
UNIFI_OS_CONSOLE=false
SWITCH_HOST=
SNMP_WRITE_COMMUNITY=private

# --- 6-bosqich: Endpoint Agent API ---
# XAVFSIZLIK (MUHIM): endi bu yerda HECH QANDAY standart/fallback qiymat
# YO'Q - agar bu qatorni bo'sh qoldirsangiz yoki hech qachon sozlamasangiz,
# server eski umumiy-kalit autentifikatsiyasini butunlay O'CHIRIB qo'yadi
# (faqat per-agent, bekor qilinadigan token'lar - `python -m api.token_
# manager --create NAME` yoki /api-tokens Dashboard sahifasi - ishlaydi).
# Bu ataylab shunday: "bo'sh = o'chirilgan" xavfsizroq, chunki eski
# versiyalarda bu yerda ochiq manba kodida ko'rinadigan standart qiymat
# ("change-me-in-production") bor edi - agar admin buni sozlashni unutsa,
# HAR QANDAY kishi o'sha ma'lum qiymat bilan API'ga kira olardi.
# Kuchli, tasodifiy qiymat generatsiya qilish uchun:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_API_KEY=
API_PORT=8443
# MUHIM: bu Windows/Linux/Mac Agent'lar serverga qayerga ulanishini
# bildiradi. `docker-compose.yml`da endi `nginx` xizmati (deploy/pki/
# generate_ca.sh orqali yaratilgan ichki CA bilan) 8443/8843 portlarida
# HAQIQIY TLS termination qiladi - agent_api/dashboard'ning o'zi hamon
# oddiy HTTP, lekin ular FAQAT 127.0.0.1'ga bog'langan, LAN'ga OCHIQ EMAS.
# Shuning uchun bu yerda "https://" ishlatiladi. O'zingizning haqiqiy
# server IP/hostname'ingizga moslang (bu qiymat TLS_SERVER_HOSTNAMES/
# TLS_SERVER_IPS'dagi SAN ro'yxatiga ham kiritilgan bo'lishi kerak -
# aks holda sertifikat tekshiruvi muvaffaqiyatsiz bo'ladi).
# Agentning o'zi bu CA'ga ishonishi uchun AGENT_CA_BUNDLE_FILE'ga
# `deploy/pki/certs/ca.crt` nusxasining yo'lini ko'rsating (masalan
# GPO orqali SYSVOL'dan tarqatilgan) - docs_TLS_SETUP.md'ga qarang.
API_SERVER_URL=https://security-agent-api.company.local
AGENT_CA_BUNDLE_FILE=
AGENT_TLS_CLIENT_CERT_FILE=
AGENT_TLS_CLIENT_KEY_FILE=

# --- TLS reverse proxy (nginx) - deploy/pki/generate_ca.sh bilan ishlatiladi ---
# Sertifikatga kiritiladigan hostname/IP ro'yxati (vergul bilan
# ajratilgan) - kamida agentlar/brauzerlar ulanadigan haqiqiy manzil
# shu yerda bo'lishi SHART (aks holda TLS tekshiruvi rad etiladi).
TLS_SERVER_HOSTNAMES=security-agent-api.company.local,dashboard.company.local,localhost
TLS_SERVER_IPS=127.0.0.1
# XAVFSIZLIK (ixtiyoriy, standart o'chiq): "true" qilinsa, Agent API
# endi HAR BIR so'rovda deploy/pki/issue_agent_cert.sh orqali chiqarilgan
# client sertifikat (mTLS) talab qiladi - qo'shimcha himoya qatlami,
# mavjud per-agent API token'ga QO'SHIMCHA (o'rniga emas).
AGENT_MTLS_REQUIRED=false

# --- Agent API: so'rov chegaralash (rate limiting) ---
# XAVFSIZLIK: bitta buzilgan/o'g'irlangan token cheksiz so'rov yuborib
# serverni yoki tashqi VirusTotal/MalwareBazaar kvotasini tugatmasligi
# uchun. Har bir chegara ALOHIDA agent/token uchun (X-API-Key bo'yicha)
# hisoblanadi - bitta agent boshqalarni bloklab qo'ymaydi. Flask-Limiter
# formati: "<son> per <second|minute|hour|day>".
API_RATE_LIMIT_CHECK_HASH=100 per minute
API_RATE_LIMIT_REPORT_INCIDENT=10 per minute
API_RATE_LIMIT_HEARTBEAT=12 per minute
API_RATE_LIMIT_ENROLL=30 per minute
API_RATE_LIMIT_GLOBAL=1000 per minute
# Bir nechta gunicorn worker/konteyner orasida chegarani UMUMIY qilish
# uchun (standart - har bir worker xotirasida ALOHIDA hisoblaydi, demak
# haqiqiy chegara worker soniga ko'paytiriladi): Redis storage tavsiya
# etiladi, masalan "redis://redis:6379/0".
RATE_LIMIT_STORAGE_URI=memory://

# --- 7-bosqich: Bildirishnomalar ---
NOTIFY_CHANNELS=email,telegram

SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=security-alerts@company.local
ADMIN_EMAIL=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- ClamAV ---
CLAMAV_DB_DIR=/var/lib/clamav

# --- Web Dashboard (RBAC - login-asosli) ---
DASHBOARD_SECRET_KEY=CHANGE_ME_RANDOM_SECRET_FOR_SESSIONS
DASHBOARD_PORT=8080
# MUHIM: bu ICHKI (Docker tarmog'idagi) port - brauzer to'g'ridan-to'g'ri
# shu portga emas, `nginx` xizmati orqali TLS bilan (standart holatda
# https://<server>:8843) ulanadi. Cookie'ning "Secure" bayrog'i to'g'ri
# ishlashi uchun SESSION_COOKIE_SECURE=true qilib qoldiring (pastga
# qarang) - faqat HTTPS orqali kirilganda ishlaydi.
# Boshlang'ich admin foydalanuvchini yaratish:
#   python -m dashboard.create_user --username admin --password '...' --role admin

# --- LDAP/Active Directory Login (ixtiyoriy) ---
# Sozlanmasa, faqat mahalliy (parol xeshlangan) autentifikatsiya ishlaydi.
LDAP_SERVER=
LDAP_AUTH_METHOD=direct_bind
LDAP_BIND_DN_TEMPLATE=cn={username},ou=people,dc=company,dc=local
# search_bind usuli uchun qo'shimcha (Active Directory'da tavsiya etiladi):
LDAP_BASE_DN=
LDAP_SERVICE_DN=
LDAP_SERVICE_PASSWORD=
LDAP_USER_SEARCH_FILTER=(cn={username})
# LDAP foydalanuvchi yaratish:
#   python -m dashboard.create_user --username jdoe --password x --role viewer --auth-source ldap

# --- RabbitMQ (ixtiyoriy, faqat --profile queue rejimida) ---
# XAVFSIZLIK: docker-compose.yml'da `rabbitmq` xizmatining o'zi endi shu
# ikkala qatordan o'qib, standart "guest:guest" o'rniga sozlaydi (15672
# boshqaruv paneli LAN'ga ochiq bo'lgani uchun bu muhim).
# `syslog_collector_queued`/`queue_ingest_worker` ham RABBITMQ_URL'ni shu
# ikkala qiymatdan avtomatik quradi - RABBITMQ_URL'ni qo'lda yozish shart
# emas (docker-compose ichida). Docker'siz, mahalliy ishga tushirishda
# (`python -m collectors.syslog_server_queued`) esa quyidagi RABBITMQ_URL
# ishlatiladi - shu ikkala login/parolga mos qiling.
RABBITMQ_USER=network_security
RABBITMQ_PASSWORD=CHANGE_ME_STRONG_RABBITMQ_PASSWORD
RABBITMQ_URL=amqp://network_security:CHANGE_ME_STRONG_RABBITMQ_PASSWORD@localhost:5672/%2F

# Dashboard HTTPS reverse proxy ortida ishlasa true qoldiring.
SESSION_COOKIE_SECURE=true

# --- Grafana (ixtiyoriy, faqat --profile grafana rejimida) ---
# XAVFSIZLIK: standart qiymat olib tashlandi - bo'sh qoldirilsa Grafana
# konteyneri ishga tushmaydi (docker-compose.yml'da endi majburiy).
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Encryption at Rest (MFA secret va h.k.) ---
# Yaratish: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Kalit almashtirish (rotation) davrida - eski kalit bilan shifrlangan
# ma'lumotlarni hali o'qish uchun (ixtiyoriy):
ENCRYPTION_KEY_OLD=

# --- Network Discovery (ixtiyoriy, faqat --profile discovery rejimida) ---
DISCOVERY_CIDR=172.16.0.0/22
DISCOVERY_INTERFACE=eth0

# --- Windows Agent Coverage (AD orqali avtomatlashtirish, ixtiyoriy) ---
AD_SERVER=ldap://172.16.0.1:389
AD_BASE_DN=dc=company,dc=local
AD_SERVICE_DN=cn=svc-netsec,ou=service-accounts,dc=company,dc=local
AD_SERVICE_PASSWORD=CHANGE_ME
AGENT_STALE_THRESHOLD_HOURS=24
HEARTBEAT_INTERVAL_SECONDS=300
