# Ushbu faylni .env nomiga ko'chirib, o'z qiymatlaringizni kiriting
NETWORK_RANGE_START=172.16.0.11
NETWORK_RANGE_END=172.16.3.254

SYSLOG_HOST=0.0.0.0
SYSLOG_PORT=5140

# Yagona ishga tushirish (SQLite) uchun:
DATABASE_URL=sqlite:///./logs/security_system.db
# Docker Compose (PostgreSQL) uchun avtomatik quriladi - pastga qarang

RAW_LOG_FILE=./logs/raw_syslog.log
LOG_LEVEL=INFO

# --- Vaqt zonasi (Toshkent, UTC+5) ---
# TZ: konteynerlarning o'z tizim vaqtini belgilaydi (masalan `docker
# logs` vaqt belgilari, cron jadvallari to'g'ri ko'rinishi uchun).
# TIMEZONE_OFFSET_HOURS: Dashboard'da FOYDALANUVCHIGA ko'rsatiladigan
# vaqt siljishi (bazaning o'zi har doim UTC'da saqlanadi - bu FAQAT
# ko'rsatish uchun, boshqa hech narsaga ta'sir qilmaydi).
TZ=Asia/Tashkent
TIMEZONE_OFFSET_HOURS=5

# --- Docker Compose uchun PostgreSQL (faqat docker-compose.yml ishlatganda) ---
POSTGRES_DB=security_system
POSTGRES_USER=security_admin
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Threat Intel API kalitlari (ixtiyoriy) ---
VT_API_KEY=

# --- 5-bosqich: Avtomatik javob choralari ---
# UniFi Controller - IKKI usul qo'llab-quvvatlanadi:
#
# USUL 1 (ASOSIY, TAVSIYA ETILADI): API Key - login/parol shart emas.
# API kalitni yaratish: UniFi Network > Control Plane > Integrations.
# Sayt ID **UUID** ko'rinishida bo'lishi kerak (masalan
# "88f7af54-98f8-306a-a1c7-c9349722b1f6"), sayt NOMI ("default") emas -
# buni UniFi'ning o'zidan (Sites ro'yxati) yoki
# GET /proxy/network/integration/v1/sites so'rovidan oling.
UNIFI_CONTROLLER_URL=https://172.16.0.1:8443
UNIFI_API_KEY=
UNIFI_SITE_ID=
UNIFI_VERIFY_SSL=false
#
# USUL 2 (ZAXIRA): login/parol - faqat API Key ishlamasa yoki eski
# dastur versiyasida ishlatiladi. USUL 1 sozlangan bo'lsa, bu qatorlar
# faqat API Key muvaffaqiyatsiz bo'lgan holatda zaxira sifatida ishlaydi.
UNIFI_USERNAME=
UNIFI_PASSWORD=
UNIFI_SITE=default
# "true" = UniFi OS konsoli (UDM/UDR/Cloud Key G2+, standart 443-port)
# "false" = self-hosted klassik dastur (masalan Docker, odatda
# standart bo'lmagan port - agar sizning portingiz 443 bo'lmasa,
# ehtimol bu "false" bo'lishi kerak)
UNIFI_OS_CONSOLE=false
SWITCH_HOST=
SNMP_WRITE_COMMUNITY=private

# --- 6-bosqich: Endpoint Agent API ---
AGENT_API_KEY=CHANGE_ME_STRONG_RANDOM_KEY
API_PORT=8443

# --- 7-bosqich: Bildirishnomalar ---
NOTIFY_CHANNELS=email,telegram

SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=security-alerts@company.local
ADMIN_EMAIL=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- ClamAV ---
CLAMAV_DB_DIR=/var/lib/clamav

# --- Web Dashboard (RBAC - login-asosli) ---
DASHBOARD_SECRET_KEY=CHANGE_ME_RANDOM_SECRET_FOR_SESSIONS
DASHBOARD_PORT=8080
# Boshlang'ich admin foydalanuvchini yaratish:
#   python -m dashboard.create_user --username admin --password '...' --role admin

# --- LDAP/Active Directory Login (ixtiyoriy) ---
# Sozlanmasa, faqat mahalliy (parol xeshlangan) autentifikatsiya ishlaydi.
LDAP_SERVER=
LDAP_AUTH_METHOD=direct_bind
LDAP_BIND_DN_TEMPLATE=cn={username},ou=people,dc=company,dc=local
# search_bind usuli uchun qo'shimcha (Active Directory'da tavsiya etiladi):
LDAP_BASE_DN=
LDAP_SERVICE_DN=
LDAP_SERVICE_PASSWORD=
LDAP_USER_SEARCH_FILTER=(cn={username})
# LDAP foydalanuvchi yaratish:
#   python -m dashboard.create_user --username jdoe --password x --role viewer --auth-source ldap

# --- RabbitMQ (ixtiyoriy, faqat --profile queue rejimida) ---
RABBITMQ_URL=amqp://guest:guest@localhost:5672/%2F

# --- Grafana (ixtiyoriy, faqat --profile grafana rejimida) ---
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Encryption at Rest (MFA secret va h.k.) ---
# Yaratish: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Kalit almashtirish (rotation) davrida - eski kalit bilan shifrlangan
# ma'lumotlarni hali o'qish uchun (ixtiyoriy):
ENCRYPTION_KEY_OLD=

# --- Network Discovery (ixtiyoriy, faqat --profile discovery rejimida) ---
DISCOVERY_CIDR=172.16.0.0/22
DISCOVERY_INTERFACE=eth0

# --- Windows Agent Coverage (AD orqali avtomatlashtirish, ixtiyoriy) ---
AD_SERVER=ldap://172.16.0.1:389
AD_BASE_DN=dc=company,dc=local
AD_SERVICE_DN=cn=svc-netsec,ou=service-accounts,dc=company,dc=local
AD_SERVICE_PASSWORD=CHANGE_ME
AGENT_STALE_THRESHOLD_HOURS=24
HEARTBEAT_INTERVAL_SECONDS=300
