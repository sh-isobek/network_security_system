# Ushbu faylni .env nomiga ko'chirib, o'z qiymatlaringizni kiriting
NETWORK_RANGE_START=172.16.0.11
NETWORK_RANGE_END=172.16.3.254

SYSLOG_HOST=0.0.0.0
SYSLOG_PORT=5140

# Yagona ishga tushirish (SQLite) uchun:
DATABASE_URL=sqlite:///./logs/security_system.db
# Docker Compose (PostgreSQL) uchun avtomatik quriladi - pastga qarang

RAW_LOG_FILE=./logs/raw_syslog.log
LOG_LEVEL=INFO

# --- Docker Compose uchun PostgreSQL (faqat docker-compose.yml ishlatganda) ---
POSTGRES_DB=security_system
POSTGRES_USER=security_admin
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Threat Intel API kalitlari (ixtiyoriy) ---
VT_API_KEY=

# --- 5-bosqich: Avtomatik javob choralari ---
UNIFI_CONTROLLER_URL=
UNIFI_USERNAME=
UNIFI_PASSWORD=
UNIFI_SITE=default
SWITCH_HOST=
SNMP_WRITE_COMMUNITY=private

# --- 6-bosqich: Endpoint Agent API ---
AGENT_API_KEY=CHANGE_ME_STRONG_RANDOM_KEY
API_PORT=8443

# --- 7-bosqich: Bildirishnomalar ---
NOTIFY_CHANNELS=email,telegram

SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=security-alerts@company.local
ADMIN_EMAIL=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- ClamAV ---
CLAMAV_DB_DIR=/var/lib/clamav

# --- Web Dashboard (RBAC - login-asosli) ---
DASHBOARD_SECRET_KEY=CHANGE_ME_RANDOM_SECRET_FOR_SESSIONS
DASHBOARD_PORT=8080
# Boshlang'ich admin foydalanuvchini yaratish:
#   python -m dashboard.create_user --username admin --password '...' --role admin

# --- LDAP/Active Directory Login (ixtiyoriy) ---
# Sozlanmasa, faqat mahalliy (parol xeshlangan) autentifikatsiya ishlaydi.
LDAP_SERVER=
LDAP_AUTH_METHOD=direct_bind
LDAP_BIND_DN_TEMPLATE=cn={username},ou=people,dc=company,dc=local
# search_bind usuli uchun qo'shimcha (Active Directory'da tavsiya etiladi):
LDAP_BASE_DN=
LDAP_SERVICE_DN=
LDAP_SERVICE_PASSWORD=
LDAP_USER_SEARCH_FILTER=(cn={username})
# LDAP foydalanuvchi yaratish:
#   python -m dashboard.create_user --username jdoe --password x --role viewer --auth-source ldap

# --- RabbitMQ (ixtiyoriy, faqat --profile queue rejimida) ---
RABBITMQ_URL=amqp://guest:guest@localhost:5672/%2F

# --- Grafana (ixtiyoriy, faqat --profile grafana rejimida) ---
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Encryption at Rest (MFA secret va h.k.) ---
# Yaratish: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Kalit almashtirish (rotation) davrida - eski kalit bilan shifrlangan
# ma'lumotlarni hali o'qish uchun (ixtiyoriy):
ENCRYPTION_KEY_OLD=
